rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'watchlist', 'notificationsEnabled', 'enrolledCourses', 'purchasedResources', 'updatedAt'])
        && data.keys().size() == 7
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.watchlist is list && data.watchlist.size() <= 50
        && data.enrolledCourses is list && data.enrolledCourses.size() <= 100
        && data.purchasedResources is list && data.purchasedResources.size() <= 500
        && data.notificationsEnabled is bool
        && data.updatedAt == request.time;
    }

    function isValidCourse(data) {
       return data.keys().hasAll(['id', 'title', 'price'])
         && data.id is string
         && data.title is string && data.title.size() <= 200
         && data.price is number && data.price >= 0;
    }

    function isValidResource(data) {
       return data.keys().hasAll(['id', 'title', 'price'])
         && data.id is string
         && data.title is string && data.title.size() <= 200
         && data.price is number && data.price >= 0;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['watchlist', 'notificationsEnabled', 'enrolledCourses', 'purchasedResources', 'updatedAt']);
      allow delete: if false;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if false; 
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
