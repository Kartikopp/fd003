type User @table {
  email: String!
  displayName: String!
  createdAt: Timestamp!
  shippingAddress: String
  billingAddress: String
  phoneNumber: String
  photoUrl: String
}

type Product @table {
  name: String!
  price: Float!
  stockQuantity: Int!
  createdAt: Timestamp!
  description: String
  imageUrl: String
  category: String
}

type Cart @table {
  user: User!
  createdAt: Timestamp!
}

type CartItem @table {
  cart: Cart!
  product: Product!
  quantity: Int!
  createdAt: Timestamp!
}

type Order @table {
  user: User!
  orderDate: Timestamp!
  totalAmount: Float!
  status: String!
  createdAt: Timestamp!
  shippingAddress: String
  billingAddress: String
}

type OrderItem @table {
  order: Order!
  product: Product!
  quantity: Int!
  priceAtPurchase: Float!
}
{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account settings and course enrollments",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "watchlist": { "type": "array", "items": { "type": "string" } },
        "notificationsEnabled": { "type": "boolean" },
        "enrolledCourses": { "type": "array", "items": { "type": "string" } },
        "purchasedResources": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "watchlist", "enrolledCourses", "purchasedResources"]
    },
    "Course": {
      "title": "Course",
      "description": "Educational content for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "instructor": { "type": "string" },
        "price": { "type": "number" },
        "duration": { "type": "string" },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "thumbnail": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "title", "price"]
    },
    "Resource": {
      "title": "PDF Resource",
      "description": "Study materials for students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "pages": { "type": "number" },
        "fileSize": { "type": "string" },
        "thumbnail": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "title", "price"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and settings"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Available marketplace courses"
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "PDF study materials"
    }
  }
}
